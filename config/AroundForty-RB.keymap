#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

#include <behaviors/rgbled_widget.dtsi>  // needed to use the behaviors
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/outputs.h>

#include "code.h"

#define ASSYM(shifted, keycode) &auto_shift shifted keycode

// レイヤー定義
// デフォルトレイヤー (接続先ごと)
#define DEFAULT_MAC_LAYER      0  // Mac用デフォルトレイヤー
#define DEFAULT_WIN_LAYER      1  // Windows用デフォルトレイヤー

// 機能レイヤー
#define LAYER_ARROW_MAC 2      // 矢印移動Macキーレイヤー
#define LAYER_ARROW_WIN 3      // 矢印移動Winキーレイヤー
#define LAYER_NUM 4            // 数字キーレイヤー
#define LAYER_FUNCTION 5       // ファンクションキーレイヤー
#define LAYER_SYMBOL 6         // 記号レイヤー
#define LAYER_MOUSE  7         // マウス操作レイヤー
#define LAYER_SCROLL 8         // スクロールレイヤー
#define LAYER_SETTINGS 9       // 設定レイヤー

//AML関連設定
&zip_temp_layer {
    excluded-positions = <
        16 // J
        17 // K
        18 // L 
        27 // M
        29 // .
        31 // LEFT_CONTROL
    >;
};

//キー入力から一定時間はAMLを発動しない
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};
//マウスキーを押したらタイムアウトを延長する
&mkp_input_listener {
    input-processors = <&zip_temp_layer LAYER_MOUSE 10000>;
};
////マウスキーを押すまでマウスレイヤーに留まる(マウスキーを押したらタイムアウトを延長すると同じ実装で、タイムアウト時間が違うだけ)
//&mkp_input_listener {
//    input-processors = <&zip_temp_layer LAYER_MOUSE 250>;
//};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos"; 
        
        To_LayerSYMBOL {
            timeout-ms = <50>;
            bindings = <&togle_symbol>;  // SYMBOLレイヤーに移動して、英数キーを押す

            key-positions = <11 12>;
            layers = <
                DEFAULT_MAC_LAYER           // Mac
                DEFAULT_WIN_LAYER           // Windows  
                LAYER_SYMBOL
            >;
        };

        To_LayerSETTING {
            bindings = <&mo LAYER_SETTINGS>;  // 設定レイヤーに移動
            //combo-term-ms = 30;
            key-positions = <34 35>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        Mac_screenshot: Mac_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N5))>;
            label = "MAC_SCREENSHOT";
        };

        Win_screenshot: Win_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(S))>;
            label = "WIN_SCREENSHOT";
        };

        to_default_layer: to_default_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to DEFAULT_MAC_LAYER &to DEFAULT_WIN_LAYER>;
            label = "TO_DEFAULT_LAYER";
        };

        exit_num_lang2: exit_num_lang2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &to_default_layer
                &kp LANG2
            >;
            label = "EXIT_NUM_LANG2";
        };

        exit_num_lang1: exit_num_lang1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <
                &to_default_layer
                &kp LANG1
            >;
            label = "EXIT_NUM_LANG1";
        };

        //AML関連設定
        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off LAYER_MOUSE>;
            label = "exit_AML";
        };

        // 記号レイヤー移動 + 英数キー
        togle_symbol: togle_symbol {
            label = "TOGGLE_SYMBOL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                <&kp LANG2>,          // 英数キー
                <&tog LAYER_SYMBOL>;  // 記号レイヤーに移動
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        //AutoShift
        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <180>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        //移動レイヤートグル
        lt_arrow_tog: lt_arrow_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_ARROW_TOG";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&tog>, <&kp>;
        };

        //矢印レイヤーに移動がたまに失敗するため
        lt_arrow: lt_arrow {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_ARROW";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };

        lt_layer_tap_preferred: lt_layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TAP_PREF";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
        
        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

//////// 重要 ////////
//３段目の右側の一番左の設定は４段目の右の左から２番めに設定する必要あり
//また４段目の右側の一番左に２番目に押すキーを設定して、３番目に１番目のキーを設定するようにしないといけない
//例として右側の設定
//タブ、Enterという設定の場合、Enter、３段目の一番左のキー、タブ
//という流れでキー設定をする
//////// 重要 ////////

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_MAC_LAYER {
            bindings = <

&kp Q             &kp W         &kp E         &kp R                                &kp T                                                                                     &kp Y                            &kp U                      &kp I                        &kp O                         &kp P
&kp A             &kp S         &kp D         &kp F                                &kp G                                                                                     &kp H                            &kp J                      &kp K                        &kp L                         &lt LAYER_SCROLL JP_SCLN
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                                &kp B                                     &kp LA(LG(V))                                   &kp N                            &kp M                      ASSYM(S_LESS_THAN,JP_COMMA)  ASSYM(S_GREATER_THAN,JP_DOT)  &mt RIGHT_SHIFT JP_COLN
&mt LCTRL LANG2   &kp LEFT_ALT  &kp LEFT_GUI  &lt_arrow LAYER_ARROW_MAC ESCAPE     &lt_layer_tap_preferred LAYER_NUM SPACE   &lt_layer_tap_preferred LAYER_FUNCTION JP_AT    &lt_arrow LAYER_ARROW_MAC ENTER  ASSYM(S_PIPE, JP_YEN_MAC)  &mt RIGHT_COMMAND TAB        &none                         &mt RCTRL LANG1 



            >;
        };

    DEFAULT_WIN_LAYER {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                  &kp T                                                           &kp Y        &kp U        &kp I          &kp O       &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G                                                           &kp H        &kp J        &kp K          &kp L       &lt LAYER_SCROLL JP_SCLN
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B            &kp LA(LG(V))                                  &kp N        &kp M        ASSYM(S_LESS_THAN,JP_COMMA)  ASSYM(S_GREATER_THAN,JP_DOT)  &mt RIGHT_SHIFT JP_COLN
&mt LCTRL LANG2   &kp LEFT_ALT  &kp LEFT_GUI  &lt_arrow LAYER_ARROW_WIN ESCAPE     &lt_layer_tap_preferred LAYER_NUM SPACE   &lt_layer_tap_preferred LAYER_FUNCTION JP_AT    &lt_arrow LAYER_ARROW_WIN ENTER  ASSYM(S_PIPE, JP_YEN_MAC)  &mt RCTRL TAB        &none                         &mt RCTRL LANG1 

            >;
        };

        LAYER_ARROW_MAC {
            bindings = <
&kp ESCAPE        &none                  &kp LC(UP_ARROW)        &none          &none                                               &kp LG(UP_ARROW)                   &kp LG(LEFT_ARROW)      &none            &kp LG(RIGHT_ARROW)      &kp LG(DOWN_ARROW)
&kp TAB           &kp LA(LG(UP_ARROW))   &kp LC(LEFT_ARROW)      &kp LC(RIGHT_ARROW)      &none                                     &kp LEFT                           &kp DOWN_ARROW          &kp UP_ARROW     &kp RIGHT_ARROW          &kp LG(JP_LBKT)
&kp LEFT_SHIFT    &kp LA(LG(DOWN_ARROW)) &kp LA(LG(LEFT_ARROW))  &kp LA(LG(RIGHT_ARROW))  &none &kp TAB                             &none                              &kp DELETE              &none            &none                    &kp LG(JP_RBKT)
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LG(Z)          &kp LG(LS(Z))            &kp LEFT_GUI                             &lt_arrow_tog LAYER_ARROW_MAC F24   &none                   &kp BACKSPACE    &none                    &Mac_screenshot
            >;
        };

        LAYER_ARROW_WIN {
            bindings = <
&kp ESCAPE        &none         &kp LG(TAB)                &none               &none                                               &kp LC(HOME)                         &kp HOME        &none                &kp END       &kp LC(END)
&kp TAB           &none         &kp LC(LG(LEFT))           &kp LC(LG(RIGHT))   &kp F12                                             &kp LEFT                             &kp DOWN_ARROW  &kp UP_ARROW         &kp RIGHT_ARROW  &kp LA(LEFT)
&kp LEFT_SHIFT    &none         &kp LS(LC(TAB))            &kp LC(TAB)         &kp LC(MINUS)   &kp TAB                             &none                                &kp DELETE                           &none           &none         &kp LA(RIGHT)
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI               &kp LC(Z)           &kp LC(Y)       &kp LEFT_ALT                        &lt_arrow_tog LAYER_ARROW_WIN F24    &none           &kp BACKSPACE        &none           &Win_screenshot
            >;
        };

        LAYER_NUM {
            bindings = <
&kp S_EXCL          &kp S_DQUO  &kp HASH     &kp S_DLR    &kp S_PERC                     &kp S_AMPR       &kp S_QUOT     &kp S_LPRN      &kp S_RPRN       &kp JP_MINS
&kp JP_1            &kp JP_2    &kp JP_3     &kp JP_4     &kp JP_5                       &kp JP_6         &kp JP_7       &kp JP_8        &kp JP_9         &kp JP_0
&none               &none       &none        &none        &none        &none             &kp JP_EQL       &kp S_ASTR     &kp S_PLUS      ASSYM(S_QUESTION, JP_SLASH)     &kp S_UNDS
&exit_num_lang2     &trans      &trans       &none        &none        &none             &kp ENTER        &none          &mt RCTRL TAB   &none                           &exit_num_lang1
            >;
        };

        LAYER_FUNCTION {
            bindings = <
&kp F1                  &kp F2  &kp F3     &kp F4 &kp F5                                         &kp F6             &kp F7                    &kp F8                  &kp F9                  &kp F10
&none                   &none   &none      &none  &kp C_VOL_UP                                   &kp LC(S_PLUS)    ASSYM(S_LCBR, JP_LBKT)    ASSYM(S_RCBR, JP_RBKT)  ASSYM(S_PLUS, JP_SEMI)  &kp F11
&kp LEFT_SHIFT          &none   &none      &none  &kp C_VOL_DN    &kp C_MUTE                     &kp LC(JP_MINS)    &none                     &none                   ASSYM(S_ASTR, JP_COLN)  &kp F12
&kp LEFT_CONTROL        &trans  &trans     &none  &none           &none                          &none              &none                     &kp RCTRL               &none                   ASSYM(S_TILDE, JP_CIRC)
            >;
        };

        LAYER_SYMBOL {
            bindings = <
&none  &none  &none  &none  &none                                          &none       &none   ASSYM(S_EQL, JP_MINS)    ASSYM(S_TILDE, JP_CIRC)   ASSYM(S_PIPE, JP_YEN_MAC)
&none  &none  &none  &none  &none                                          &none       &none   &none                    ASSYM(S_BQ, JP_AT)        ASSYM(S_LCBR, JP_LBKT)
&kp LEFT_SHIFT  &none  &none  &none  &none  &kp LANG2                      &none       &none   ASSYM(S_PLUS, JP_SEMI)   ASSYM(S_ASTR, JP_COLN)    ASSYM(S_RCBR, JP_RBKT)
&kp LEFT_CONTROL     &kp LEFT_ALT  &kp LEFT_GUI  &none  &none  &none       &none       &kp RCTRL   &kp LANG1  &none                          &none
            >;
        };

//例として右側の設定
//タブ、Enterという設定の場合、Enter、３段目の一番左のキー、タブ
//という流れでキー設定をする

        LAYER_MOUSE {
            bindings = <
&trans          &trans        &trans        &trans     &trans          &trans    &trans     &trans     &trans     &trans
&trans          &trans        &trans        &trans     &trans          &mkp MB4  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MB5
&kp LEFT_SHIFT  &trans        &trans        &trans     &trans  &mkp LCLK  &trans    &mkp LCLK  &none      &mkp RCLK  &none
&kp LCTRL       &kp LEFT_ALT  &kp LEFT_GUI  &exit_AML  &trans  &trans  &trans     &trans    &trans     &trans     &trans
            >;
        };

        LAYER_SCROLL {
            bindings = <
&none  &none  &none  &none  &none                                    &none  &none        &none  &none        &none
&none  &none  &none  &none  &none                                    &none  &none        &none  &none        &none
&kp LEFT_SHIFT  &none  &none  &none  &none  &none                    &none  &mkp LCLK    &none  &mkp RCLK    &none
&kp LCTRL       &kp LEFT_ALT  &kp LEFT_GUI  &none  &none  &none      &kp RIGHT_COMMAND  &none &mt RCTRL TAB    &none    &none
            >;
        };

        LAYER_SETTINGS {
            bindings = <
&kp JP_AT  &trans  &trans  &trans  &trans               &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4
&trans     &trans  &trans  &trans  &trans               &kp CAPS        &to 0           &trans          &to 1         &trans
&trans     &trans  &trans  &trans  &trans  &bootloader  &kp KP_NUMLOCK  &none           &trans          &bootloader   &bt BT_CLR
&trans     &trans  &trans  &trans  &trans  &sys_reset   &out OUT_BLE    &none           &out OUT_USB    &sys_reset   &bt BT_CLR_ALL
            >;
        };
    };
};
