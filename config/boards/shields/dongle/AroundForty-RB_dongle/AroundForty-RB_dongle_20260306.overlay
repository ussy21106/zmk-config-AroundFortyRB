#include "../../common/AroundForty-RB.dtsi"
#include <input/processors.dtsi>                                 /* # input processor定義を使う（ここは必ずファイル先頭へ） */
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>


&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
            , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};
/{
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <4>;               
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                        RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                        RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                RC(3,9) RC(3,7) RC(3,8) RC(3,6) RC(3,10)         
        >;
    };
};


/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        //input-processors = <&zip_temp_layer 9 100000>;
        input-processors = <&zip_xy_transform (INPUT_TRANSFORM_Y_INVERT)>, <&zip_temp_layer 9 100000>;

        scroll_override {                                        /* # レイヤー中だけスクロール化（対応しているfork/版のみ有効） */
            layers = <2 5>;                                      /* # スクロール化したいレイヤー番号 */
            input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 12>;       /* # XY移動→スクロールに変換 */
            process-next;                                        /* # B：この後もベース（zip_temp_layer）を続けて適用 */
        };                                                       /* # override終わり */
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        //automouse-layer = <8>;
        //scroll-layers = <10>;

        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;

        /* 旧 .conf からの移行例（必要に応じてコメントアウトを外して使用） */
        cpi = <400>;       /* 旧: CONFIG_PMW3610_CPI=700 */
        invert-x;          /* 旧: CONFIG_PMW3610_INVERT_X=y */
        //invert-y;          /* 旧: CONFIG_PMW3610_INVERT_Y=y */
    };
};


